<?php // Rendered by a theme calling $template['serviceBlock']('leaflet-maps-assets').
// Loads Leaflet, MarkerCluster and this service's script. Call it once per page
// that shows a map; pages without a map should not call it, so nothing loads there.
// Files live in assets/services/leaflet-maps/ (copied from this service's public/ on install).
$base = '/assets/services/leaflet-maps';
$version = static function (string $file) use ($base): string {
    $path = ($_SERVER['DOCUMENT_ROOT'] ?? '') . "{$base}/{$file}";
    return \is_file($path) ? '?v=' . \filemtime($path) : '';
};
?>
<link rel="stylesheet" href="<?= $base ?>/leaflet.css">
<link rel="stylesheet" href="<?= $base ?>/MarkerCluster.css">
<link rel="stylesheet" href="<?= $base ?>/MarkerCluster.Default.css">
<link rel="stylesheet" href="<?= $base ?>/osmium-maps.css<?= $version('osmium-maps.css') ?>">
<script src="<?= $base ?>/leaflet.js" defer></script>
<script src="<?= $base ?>/leaflet.markercluster.js" defer></script>
<script src="<?= $base ?>/osmium-maps.js<?= $version('osmium-maps.js') ?>" defer></script>
